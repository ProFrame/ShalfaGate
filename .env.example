# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Deployment prefix. Leave unset for bbnovix.com: the app is served from the
# domain root because the first path segment is the company (/shalfa/, /seder/).
# Set it only when publishing under a sub-directory, e.g. /bbnovix/
# VITE_BASE_PATH=/

# Do not put service-role, SMTP, database passwords, or paid API keys in this
# frontend env file. Vite only exposes variables prefixed with VITE_, but keeping
# production secrets out of the web app workspace avoids accidental leaks.

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — set with `supabase secrets set`, never here.
# ---------------------------------------------------------------------------
# APP_URL=https://bbnovix.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bbnovix@gmail.com
# SMTP_PASS=<Gmail App Password, not the account password>
# MAIL_FROM=bbnovix <bbnovix@gmail.com>
